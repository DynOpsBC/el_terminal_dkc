<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>OKUTULAN BARKOD</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>18pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#334155</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0.45in</Top>
            <Left>0.35in</Left>
            <Height>0.4in</Height>
            <Width>6.55in</Width>
            <Style />
          </Textbox>
          <Textbox Name="BarcodeValue">
            <CanGrow>false</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!EncodedBarcode.Value</Value>
                    <Style>
                      <FontFamily>IDAutomationC128M</FontFamily>
                      <FontSize>=IIF(Len(Fields!BarcodeValue.Value) &gt; 32, "20pt", IIF(Len(Fields!BarcodeValue.Value) &gt; 20, "28pt", "36pt"))</FontSize>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>1.05in</Top>
            <Left>0.35in</Left>
            <Height>1.25in</Height>
            <Width>6.55in</Width>
            <Style>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>12pt</PaddingLeft>
              <PaddingRight>12pt</PaddingRight>
            </Style>
          </Textbox>
          <Textbox Name="HumanReadableValue">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!BarcodeValue.Value</Value>
                    <Style>
                      <FontFamily>Consolas</FontFamily>
                      <FontSize>22pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>2.4in</Top>
            <Left>0.35in</Left>
            <Height>0.7in</Height>
            <Width>6.55in</Width>
            <Style>
              <Border>
                <Style>Solid</Style>
                <Color>#94A3B8</Color>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>8pt</PaddingLeft>
              <PaddingRight>8pt</PaddingRight>
              <PaddingTop>4pt</PaddingTop>
              <PaddingBottom>4pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="PrintedAt">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="BCWMS terminal baskı testi · " &amp; Fields!PrintedAt.Value</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>10pt</FontSize>
                      <Color>#64748B</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>3.3in</Top>
            <Left>0.35in</Left>
            <Height>0.3in</Height>
            <Width>6.55in</Width>
            <Style />
          </Textbox>
        </ReportItems>
        <Height>3.9in</Height>
        <Style />
      </Body>
      <Width>7.27in</Width>
      <Page>
        <PageHeight>11.69in</PageHeight>
        <PageWidth>8.27in</PageWidth>
        <LeftMargin>0.5in</LeftMargin>
        <RightMargin>0.5in</RightMargin>
        <TopMargin>0.5in</TopMargin>
        <BottomMargin>0.5in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <Language>=User!Language</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>f45ec4cd-a0cb-43d8-a3c7-736559d0cb7d</rd:ReportID>
  <DataSets>
    <DataSet Name="DataSet_Result">
      <Fields>
        <Field Name="EncodedBarcode">
          <DataField>EncodedBarcode</DataField>
        </Field>
        <Field Name="BarcodeValue">
          <DataField>BarcodeValue</DataField>
        </Field>
        <Field Name="PrintedAt">
          <DataField>PrintedAt</DataField>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText />
      </Query>
    </DataSet>
  </DataSets>
</Report>